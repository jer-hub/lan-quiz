# Server bind address (inside the container always 0.0.0.0)
HOST=0.0.0.0
PORT=8000

# Your computer's LAN IP — other devices use this in QR codes / join URLs.
# Find it: Windows `ipconfig` | macOS/Linux `ip addr` or `hostname -I`
# Example: HOST_IP=192.168.1.42
HOST_IP=localhost

LOG_LEVEL=INFO
SCORE_BASE=1000

# JWT for teacher/student auth — change this before real classroom use
JWT_SECRET=change-me-lanquiz-dev-secret
JWT_EXPIRE_HOURS=72
# Fail-fast guard: app refuses to boot with the default JWT_SECRET unless true.
# Keep false in production; true is for local dev only.
ALLOW_DEFAULT_SECRET=false
